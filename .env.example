# Copia questo file in .env e sostituisci TUTTI i valori "cambia-..." (docs/dev/SETUP-WINDOWS.md, passo 4).
# Non committare mai .env.

APP_NAME="Booking Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Timestamp sempre in UTC (CLAUDE.md, regola 6); la visualizzazione usa il fuso della struttura.
APP_TIMEZONE=UTC
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL (servizio Docker "postgres") ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# Deve coincidere con DB_HOST_PORT.
DB_PORT=5434
DB_DATABASE=booking_engine
DB_TEST_DATABASE=booking_engine_test
# Database dei test E2E (npm run test:e2e): il database di sviluppo non viene toccato.
DB_E2E_DATABASE=booking_engine_e2e

# Ruolo di runtime dell'applicazione: NOSUPERUSER, NOBYPASSRLS, solo DML (connessione "pgsql").
DB_USERNAME=app_runtime
DB_PASSWORD=cambia-password-runtime

# Ruolo delle migration, proprietario delle tabelle (connessione "pgsql_migrator").
DB_MIGRATOR_USERNAME=app_migrator
DB_MIGRATOR_PASSWORD=cambia-password-migrator

# Ruolo per i dispatcher dei job cross-tenant (connessione "pgsql_admin_ops"); mai nelle richieste HTTP.
DB_ADMIN_OPS_USERNAME=app_admin_ops
DB_ADMIN_OPS_PASSWORD=cambia-password-admin-ops

# Superutente PostgreSQL: usato solo dagli script di inizializzazione di Docker, mai dall'applicazione.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambia-password-superutente

# Porta host di PostgreSQL (docker-compose.yml); predefinita 5434 per non collidere con altri progetti.
DB_HOST_PORT=5434

# --- Redis (servizio Docker "redis") ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
# Deve coincidere con REDIS_HOST_PORT.
REDIS_PORT=6380
# Porta host di Redis (docker-compose.yml); predefinita 6380 per non collidere con altri progetti.
REDIS_HOST_PORT=6380

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In locale il pannello gira su http: cookie di sessione non "secure" (in produzione resta true).
SESSION_SECURE_COOKIE=false
# Domini da cui la SPA del pannello usa la sessione Sanctum (08).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# In locale: php artisan queue:work (Horizon solo in staging e produzione, ADR-0006).
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage S3 compatibile: solo staging e produzione (ADR-0006).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
