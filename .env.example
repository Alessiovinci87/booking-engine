# --- Servizi Docker locali (docker-compose.yml) ---
# Superutente PostgreSQL: usato solo dagli script di inizializzazione, mai dall'applicazione.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambia-questa-password
DB_DATABASE=booking_engine
DB_TEST_DATABASE=booking_engine_test
# Porta host di Redis (docker-compose.yml); predefinita 6380 per non collidere con altri progetti.
REDIS_HOST_PORT=6380
# Porta host di PostgreSQL (docker-compose.yml); predefinita 5434 per non collidere con altri progetti.
DB_HOST_PORT=5434
