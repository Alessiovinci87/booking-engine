includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Livello 8 su tutto il codice, senza baseline né errori ignorati (ADR-0006; attività 7.4, ADR-0018).
    level: 8
    paths:
        - app
        - bootstrap/app.php
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
